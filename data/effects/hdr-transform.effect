// HDR Toolkit - HDR Transform (hdr_toolkit_transform_v1), Corner Pin
// Copyright (C) 2026 srl01-coding, GPL-2.0-or-later
//
// Written from the implementation brief (sections 4.3, 4.4); no StreamFX code.
// The inverse-map functions are mirrored line for line in
// src/transform/quad-math.cpp (shader_inverse_*) and tested there.
//
// `image` is the filter texrender: premultiplied linear RGB in the target's
// native OBS colour space. Geometry only: no clamp of RGB. Pixels outside the
// warped quad are transparent black.
//
// Schema 3 (8 Nov 2026, user): output size (resize after the corner pin, so the
// whole geometry is one resample) and High quality sampling (SampleHQ): 6x6
// Lanczos-3 in the source grid at the mapped point, kernel widened along the local
// footprint where the warp reduces, PQ-domain interpolation with anti-ringing where
// it enlarges, linear light where it reduces (blended in between). Mirrored in
// src/transform/warp-math.cpp - keep in lock-step.

uniform float4x4 ViewProj;
uniform texture2d image;

// Bilinear (StreamFX-style) warp: P(u,v) = A + e*u + f*v + g*u*v
uniform float2 quad_a;
uniform float2 quad_e;
uniform float2 quad_f;
uniform float2 quad_g;

// Projective warp: rows of the normalised inverse homography
uniform float3 hinv0;
uniform float3 hinv1;
uniform float3 hinv2;
uniform float w_sign = 1.0;

// Pre-warp (schema 2): rotation, then barrel / pincushion, before the corner pin.
// Sampling map, mirrored in quad-math.cpp shader_prewarp(). pre_on = 0 skips it.
uniform float pre_on = 0.0;
uniform float2 pre_cs = {1.0, 0.0};      // cos, sin of the clockwise rotation
uniform float pre_k = 0.0;               // radial coefficient (+ barrel, - pincushion)
uniform float pre_inv_hd2 = 0.0;         // 4 / (W^2 + H^2)
uniform float pre_scale = 1.0;           // fill scale
uniform float2 pre_size = {1920.0, 1080.0};

// Schema 3: output size and resampling
uniform texture2d pq_image;              // PQ-encoded copy of image (SampleHQ), RGBA16F
uniform float2 out_size = {1920.0, 1080.0};
uniform float2 in_size = {1920.0, 1080.0};
uniform float2 res_scale = {1.0, 1.0};   // output pixels per frame pixel
uniform float2 res_offset = {0.0, 0.0};  // frame px = (out px) / res_scale + res_offset
uniform int warp = 0;                    // 0 bilinear corner pin, 1 projective
uniform float antiring = 0.8;
uniform float pq_k = 0.0203;             // nits per unit / 10000

sampler_state linear_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state point_sampler {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float cross2(float2 a, float2 b)
{
	return a.x * b.y - a.y * b.x;
}

// Returns (u, v, valid).
float3 inverse_bilinear(float2 p)
{
	float uv_tol = 0.00001;
	float2 h = p - quad_a;
	float qa = cross2(quad_g, quad_f);
	float qb = cross2(quad_e, quad_f) + cross2(h, quad_g);
	float qc = cross2(h, quad_e);

	float v1;
	float v2;
	if (abs(qa) <= 0.000001 * abs(qb)) {
		if (abs(qb) < 0.000000000001)
			return float3(0.0, 0.0, 0.0);
		v1 = -qc / qb;
		v2 = v1;
	} else {
		float disc = qb * qb - 4.0 * qa * qc;
		if (disc < -0.00001 * (qb * qb + abs(4.0 * qa * qc)))
			return float3(0.0, 0.0, 0.0);
		disc = max(disc, 0.0);
		float sgn = (qb >= 0.0) ? 1.0 : -1.0;
		float z = -0.5 * (qb + sgn * sqrt(disc));
		if (abs(z) < 0.000000000001) {
			v1 = -qb / (2.0 * qa);
			v2 = v1;
		} else {
			v1 = z / qa;
			v2 = qc / z;
		}
	}

	float best_r = 1000000.0;
	float3 best = float3(0.0, 0.0, 0.0);

	// candidate 1
	float2 k = quad_e + quad_g * v1;
	float kk = dot(k, k);
	if (kk > 0.000000000001) {
		float u = dot(h - quad_f * v1, k) / kk;
		if (u >= -uv_tol && u <= 1.0 + uv_tol && v1 >= -uv_tol && v1 <= 1.0 + uv_tol) {
			float2 rr = quad_a + quad_e * u + quad_f * v1 + quad_g * (u * v1) - p;
			float r = dot(rr, rr);
			if (r < best_r) {
				best_r = r;
				best = float3(u, v1, 1.0);
			}
		}
	}
	// candidate 2
	k = quad_e + quad_g * v2;
	kk = dot(k, k);
	if (kk > 0.000000000001) {
		float u2 = dot(h - quad_f * v2, k) / kk;
		if (u2 >= -uv_tol && u2 <= 1.0 + uv_tol && v2 >= -uv_tol && v2 <= 1.0 + uv_tol) {
			float2 rr2 = quad_a + quad_e * u2 + quad_f * v2 + quad_g * (u2 * v2) - p;
			float r2 = dot(rr2, rr2);
			if (r2 < best_r) {
				best_r = r2;
				best = float3(u2, v2, 1.0);
			}
		}
	}
	return best;
}

float3 inverse_projective(float2 p)
{
	float uv_tol = 0.00001;
	float3 pp = float3(p, 1.0);
	float qx = dot(hinv0, pp);
	float qy = dot(hinv1, pp);
	float qz = dot(hinv2, pp);
	if (!(qz * w_sign > 0.0000001))
		return float3(0.0, 0.0, 0.0);
	float u = qx / qz;
	float v = qy / qz;
	if (u >= -uv_tol && u <= 1.0 + uv_tol && v >= -uv_tol && v <= 1.0 + uv_tol)
		return float3(u, v, 1.0);
	return float3(0.0, 0.0, 0.0);
}

// Returns (u, v, valid) in the source texture for a point of the pre-warped image.
float3 pre_warp(float2 uv)
{
	float uv_tol = 0.00001;
	float2 d = (uv - float2(0.5, 0.5)) * pre_size;
	float r2 = dot(d, d) * pre_inv_hd2;
	float2 e = d * ((1.0 + pre_k * r2) * pre_scale);
	float2 s = float2(pre_cs.x * e.x + pre_cs.y * e.y, -pre_cs.y * e.x + pre_cs.x * e.y);
	float2 q = s / pre_size + float2(0.5, 0.5);
	if (q.x >= -uv_tol && q.x <= 1.0 + uv_tol && q.y >= -uv_tol && q.y <= 1.0 + uv_tol)
		return float3(q, 1.0);
	return float3(0.0, 0.0, 0.0);
}

// Corner pin, then (when on) the pre-warp sampling map.
float3 full_map(float3 m)
{
	if (m.z < 0.5 || pre_on < 0.5)
		return m;
	return pre_warp(clamp(m.xy, 0.0, 1.0));
}

// Output pixel position (pixel units, centres at +0.5) -> source (u, v, valid).
float3 map_px(float2 c)
{
	float2 fr = (c / res_scale + res_offset) / in_size;
	float3 m = warp == 1 ? inverse_projective(fr) : inverse_bilinear(fr);
	return full_map(m);
}

// Valid UVs are clamped by the tolerance only; invalid ones never sample, so
// edge pixels are not smeared outside the quad.
float4 PSSampleLinear(VertInOut vert_in) : TARGET
{
	float2 c = floor(vert_in.uv * out_size) + 0.5;
	float3 m = map_px(c);
	if (m.z < 0.5)
		return float4(0.0, 0.0, 0.0, 0.0);
	return image.Sample(linear_sampler, clamp(m.xy, 0.0, 1.0));
}

float4 PSSamplePoint(VertInOut vert_in) : TARGET
{
	float2 c = floor(vert_in.uv * out_size) + 0.5;
	float3 m = map_px(c);
	if (m.z < 0.5)
		return float4(0.0, 0.0, 0.0, 0.0);
	return image.Sample(point_sampler, clamp(m.xy, 0.0, 1.0));
}

float pq_encode(float y)
{
	float p = pow(max(y, 0.0), 0.1593017578125);
	return pow((0.8359375 + 18.8515625 * p) / (1.0 + 18.6875 * p), 78.84375);
}

float pq_decode(float e)
{
	float p = pow(max(e, 0.0), 1.0 / 78.84375);
	return pow(max(p - 0.8359375, 0.0) / (18.8515625 - 18.6875 * p), 1.0 / 0.1593017578125);
}

float enc1(float v)
{
	float e = pq_encode(abs(v) * pq_k);
	return v < 0.0 ? -e : e;
}

float dec1(float v)
{
	float d = pq_decode(abs(v)) / pq_k;
	return v < 0.0 ? -d : d;
}

// Pre-pass for SampleHQ: PQ-encoded copy (RGB), alpha unchanged. Same size as the input.
float4 PSEncodePQ(VertInOut vert_in) : TARGET
{
	int2 p = int2(vert_in.uv * in_size);
	float4 c = image.Load(int3(p, 0));
	return float4(enc1(c.r), enc1(c.g), enc1(c.b), c.a);
}

float lanczos3(float x)
{
	float ax = abs(x);
	if (ax < 0.00001)
		return 1.0;
	if (ax >= 3.0)
		return 0.0;
	float px = 3.14159265358979 * x;
	return 3.0 * sin(px) * sin(px / 3.0) / (px * px);
}

float snap(float v)
{
	float r = round(v);
	return abs(v - r) < 0.001 ? r : v;
}

float4 PSSampleHQ(VertInOut vert_in) : TARGET
{
	float2 c = floor(vert_in.uv * out_size) + 0.5;
	float3 m0 = map_px(c);
	if (m0.z < 0.5)
		return float4(0.0, 0.0, 0.0, 0.0);
	// local footprint: source texels per output pixel (forward difference, else backward)
	float3 mx = map_px(c + float2(1.0, 0.0));
	float sgx = 1.0;
	if (mx.z < 0.5) {
		mx = map_px(c - float2(1.0, 0.0));
		sgx = -1.0;
	}
	float3 my = map_px(c + float2(0.0, 1.0));
	float sgy = 1.0;
	if (my.z < 0.5) {
		my = map_px(c - float2(0.0, 1.0));
		sgy = -1.0;
	}
	float2 jx = mx.z > 0.5 ? (mx.xy - m0.xy) * in_size * sgx : float2(1.0 / res_scale.x, 0.0);
	float2 jy = my.z > 0.5 ? (my.xy - m0.xy) * in_size * sgy : float2(0.0, 1.0 / res_scale.y);
	// M = J J^T, eigen-decomposition
	float ma = jx.x * jx.x + jy.x * jy.x;
	float mb = jx.x * jx.y + jy.x * jy.y;
	float md = jx.y * jx.y + jy.y * jy.y;
	float tr = 0.5 * (ma + md);
	float dt = sqrt(max(0.25 * (ma - md) * (ma - md) + mb * mb, 0.0));
	float s1 = sqrt(max(tr + dt, 0.0));
	float s2 = sqrt(max(tr - dt, 0.0));
	float2 e1;
	if (abs(mb) > 0.000001)
		e1 = normalize(float2(tr + dt - md, mb));
	else
		e1 = ma >= md ? float2(1.0, 0.0) : float2(0.0, 1.0);
	float2 e2 = float2(-e1.y, e1.x);
	float w1 = s1 < 1.001 ? 1.0 : min(s1, 2.0);
	float w2 = s2 < 1.001 ? 1.0 : min(s2, 2.0);
	// F^-1 and F (symmetric)
	float fi00 = e1.x * e1.x / w1 + e2.x * e2.x / w2;
	float fi01 = e1.x * e1.y / w1 + e2.x * e2.y / w2;
	float fi11 = e1.y * e1.y / w1 + e2.y * e2.y / w2;
	float f00 = e1.x * e1.x * w1 + e2.x * e2.x * w2;
	float f01 = e1.x * e1.y * w1 + e2.x * e2.y * w2;
	float f11 = e1.y * e1.y * w1 + e2.y * e2.y * w2;
	float tdom = smoothstep(1.001, 1.5, s1); // 0: PQ (enlarging), 1: linear (reducing)

	float2 q = m0.xy * in_size - 0.5;
	q = float2(snap(q.x), snap(q.y));
	int nw = int(in_size.x), nh = int(in_size.y);
	if (q.x == round(q.x) && q.y == round(q.y) && w1 == 1.0 && w2 == 1.0) {
		int2 t = int2(clamp(int(q.x), 0, nw - 1), clamp(int(q.y), 0, nh - 1));
		return image.Load(int3(t, 0));
	}
	if (w1 == 1.0 && w2 == 1.0) {
		// Fast path (the picture is not reduced here): F = I, so the 2-D kernel is the
		// product of two 1-D Lanczos-3 weight sets; tdom = 0, so only the PQ copy is read
		// (it carries alpha), and the anti-ringing range is the centre 2 x 2 of the taps.
		int bx = int(floor(q.x)) - 2, by = int(floor(q.y)) - 2;
		float wx[6];
		float wy[6];
		float sx = 0.0, sy = 0.0;
		for (int a = 0; a < 6; a++) {
			wx[a] = lanczos3(q.x - float(bx + a));
			wy[a] = lanczos3(q.y - float(by + a));
			sx += wx[a];
			sy += wy[a];
		}
		float4 acc = float4(0.0, 0.0, 0.0, 0.0);
		float3 lo = float3(1e30, 1e30, 1e30);
		float3 hi = float3(-1e30, -1e30, -1e30);
		for (int jj = 0; jj < 6; jj++) {
			int yy = clamp(by + jj, 0, nh - 1);
			float4 row = float4(0.0, 0.0, 0.0, 0.0);
			for (int ii = 0; ii < 6; ii++) {
				float4 t = pq_image.Load(int3(clamp(bx + ii, 0, nw - 1), yy, 0));
				row += wx[ii] * t;
				if ((ii == 2 || ii == 3) && (jj == 2 || jj == 3)) {
					lo = min(lo, t.rgb);
					hi = max(hi, t.rgb);
				}
			}
			acc += wy[jj] * row;
		}
		float4 r = acc / (sx * sy);
		r.rgb = r.rgb + (clamp(r.rgb, lo, hi) - r.rgb) * antiring;
		return float4(dec1(r.r), dec1(r.g), dec1(r.b), saturate(r.a));
	}
	float ex = 3.0 * (abs(f00) + abs(f01));
	float ey = 3.0 * (abs(f01) + abs(f11));
	int x0 = int(floor(q.x - ex)) + 1;
	int y0 = int(floor(q.y - ey)) + 1;
	int nx = min(int(floor(q.x + ex)) - x0 + 1, 20);
	int ny = min(int(floor(q.y + ey)) - y0 + 1, 20);
	int count = nx * ny;
	float4 accl = float4(0.0, 0.0, 0.0, 0.0);
	float3 accp = float3(0.0, 0.0, 0.0);
	float wsum = 0.0;
	for (int k = 0; k < 400; k++) {
		if (k >= count)
			break;
		int i = x0 + k % nx;
		int j = y0 + k / nx;
		float2 d = q - float2(float(i), float(j));
		float dx = fi00 * d.x + fi01 * d.y;
		float dy = fi01 * d.x + fi11 * d.y;
		float w = lanczos3(dx) * lanczos3(dy);
		int3 t = int3(clamp(i, 0, nw - 1), clamp(j, 0, nh - 1), 0);
		accl += w * image.Load(t);
		accp += w * pq_image.Load(t).rgb;
		wsum += w;
	}
	float inv = wsum != 0.0 ? 1.0 / wsum : 0.0;
	float4 rl = accl * inv;
	float3 rp = accp * inv;
	// anti-ringing (PQ path): towards the range of the 2 x 2 nearest texels
	int ix = int(floor(q.x)), iy = int(floor(q.y));
	float3 n00 = pq_image.Load(int3(clamp(ix, 0, nw - 1), clamp(iy, 0, nh - 1), 0)).rgb;
	float3 n10 = pq_image.Load(int3(clamp(ix + 1, 0, nw - 1), clamp(iy, 0, nh - 1), 0)).rgb;
	float3 n01 = pq_image.Load(int3(clamp(ix, 0, nw - 1), clamp(iy + 1, 0, nh - 1), 0)).rgb;
	float3 n11 = pq_image.Load(int3(clamp(ix + 1, 0, nw - 1), clamp(iy + 1, 0, nh - 1), 0)).rgb;
	float3 lo = min(min(n00, n10), min(n01, n11));
	float3 hi = max(max(n00, n10), max(n01, n11));
	rp = rp + (clamp(rp, lo, hi) - rp) * antiring;
	float3 dp = float3(dec1(rp.r), dec1(rp.g), dec1(rp.b));
	float3 rgb = lerp(dp, rl.rgb, tdom);
	return float4(rgb, saturate(rl.a));
}

float catmull_rom(float x)
{
	x = abs(x);
	if (x < 1.0)
		return (1.5 * x - 2.5) * x * x + 1.0;
	if (x < 2.0)
		return ((-0.5 * x + 2.5) * x - 4.0) * x + 2.0;
	return 0.0;
}

// Sharp (bicubic): Catmull-Rom over 4 x 4 texels at the mapped point, linear light,
// anti-ringing towards the range of the centre 2 x 2. No pre-pass, constant cost.
float4 PSSampleBicubic(VertInOut vert_in) : TARGET
{
	float2 c = floor(vert_in.uv * out_size) + 0.5;
	float3 m = map_px(c);
	if (m.z < 0.5)
		return float4(0.0, 0.0, 0.0, 0.0);
	float2 q = m.xy * in_size - 0.5;
	q = float2(snap(q.x), snap(q.y));
	int nw = int(in_size.x), nh = int(in_size.y);
	int bx = int(floor(q.x)) - 1, by = int(floor(q.y)) - 1;
	float wx[4];
	float wy[4];
	for (int a = 0; a < 4; a++) {
		wx[a] = catmull_rom(q.x - float(bx + a));
		wy[a] = catmull_rom(q.y - float(by + a));
	}
	float4 acc = float4(0.0, 0.0, 0.0, 0.0);
	float4 lo = float4(1e30, 1e30, 1e30, 1e30);
	float4 hi = float4(-1e30, -1e30, -1e30, -1e30);
	for (int jj = 0; jj < 4; jj++) {
		int yy = clamp(by + jj, 0, nh - 1);
		float4 row = float4(0.0, 0.0, 0.0, 0.0);
		for (int ii = 0; ii < 4; ii++) {
			float4 t = image.Load(int3(clamp(bx + ii, 0, nw - 1), yy, 0));
			row += wx[ii] * t;
			if ((ii == 1 || ii == 2) && (jj == 1 || jj == 2)) {
				lo = min(lo, t);
				hi = max(hi, t);
			}
		}
		acc += wy[jj] * row;
	}
	acc = acc + (clamp(acc, lo, hi) - acc) * antiring;
	return float4(acc.rgb, saturate(acc.a));
}

technique SampleBicubic
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSSampleBicubic(vert_in);
	}
}

technique SampleLinear
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSSampleLinear(vert_in);
	}
}

technique SamplePoint
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSSamplePoint(vert_in);
	}
}

technique EncodePQ
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSEncodePQ(vert_in);
	}
}

technique SampleHQ
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSSampleHQ(vert_in);
	}
}
